        { "id": "add-action", "required": true, "accepts": ["button"] }
      ],
      "stateModel": ["empty", "editing", "invalid", "ready-to-add", "adding"],
      "behaviorTargets": ["draft-row.change", "draft-row.validate", "draft-row.commit-to-list"],
      "scrollOwner": "none",
