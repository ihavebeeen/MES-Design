      "behaviorTargets": ["custom-field.change", "custom-field.define"],
      "scrollOwner": "section",
      "allowedActionSets": [],
      "useWhen": ["MES 공통 스키마와 구분되는 수용가·대상 유형·사용자 정의 필드를 같은 저장 단위에서 편집할 때"],
      "doNotUseWhen": ["모든 수용가에 공통인 기본정보", "임의의 보조 필드를 중요도가 낮다는 이유만으로 분리할 때"],
      "constraints": ["커스텀이라는 이유로 필수성·검증·레이블 위계를 낮추지 않는다.", "필드 정의와 필드 값 입력의 권한을 구분한다."],
      "evidence": ["custom-information", "user-password-settings"],
      "goldenScreenIds": ["custom-information"],
      "implementationMarkers": ["SlideCompositionSectionView"]
