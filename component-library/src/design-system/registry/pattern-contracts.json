        { "id": "search-sort", "required": false, "accepts": ["search", "sort"] },
        { "id": "bulk-judgement", "required": false, "accepts": ["inspection-judgement"] },
        { "id": "items", "required": true, "accepts": ["inspection-row"] },
        { "id": "add-action", "required": false, "accepts": ["button"] },
        { "id": "empty", "required": false, "accepts": ["empty-state"] }
      ],
      "stateModel": ["empty", "editable", "readonly", "bulk-selected"],
      "behaviorTargets": ["inspection.item-change", "inspection.bulk-change"],
      "scrollOwner": "section",
      "allowedActionSets": [],
      "useWhen": ["검사항목과 O·△·X 같은 판정값을 반복 입력"],
      "doNotUseWhen": ["일반 데이터 목록", "단순 라디오 그룹"],
      "constraints": ["섹션 헤더는 전체 폭을 사용한다.", "판정 상태와 입력 동작을 같은 state에서 관리한다."],
      "evidence": ["self-inspection", "form-inspection-criteria"],
      "goldenScreenIds": ["self-inspection"],
      "implementationMarkers": ["InspectionItemsSection"]
