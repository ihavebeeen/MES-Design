{
  "schemaVersion": 1,
  "contracts": [
    {
      "patternId": "shell.center-modal",
      "slots": [
        { "id": "header", "required": true, "accepts": ["title", "dismiss-action"] },
        { "id": "body", "required": true, "accepts": ["section-instance"] },
        { "id": "footer", "required": false, "accepts": ["action-set"] }
      ],
      "stateModel": ["closed", "open", "dismissing", "committing"],
      "behaviorTargets": ["shell.dismiss", "shell.commit"],
      "scrollOwner": "shell-body",
      "allowedActionSets": ["action-set.cancel-save", "action-set.cancel-confirm", "action-set.save-only", "action-set.close-only", "action-set.cancel-select", "action-set.cancel-input"],
      "useWhen": ["전체 컨셉과 적용 가능한 MES 계약 또는 사용자 지정이 중앙 작업 형식"],
      "doNotUseWhen": ["유지해야 할 원본/계약은 우측인데 배경 유지·건수·길이만으로 중앙으로 바꾸는 경우", "짧은 확인만 있는 confirm dialog"],
      "constraints": ["본문만 스크롤하고 헤더와 푸터를 고정한다.", "원본 size 또는 승인 preset을 사용한다."],
      "evidence": ["batch-work-order", "material-input-settings", "inventory-add"],
      "goldenScreenIds": ["batch-work-order"],
      "implementationMarkers": ["CenterModal"]
    },
    {
      "patternId": "shell.side-slide-panel",
      "slots": [
        { "id": "header", "required": true, "accepts": ["title", "dismiss-action"] },
        { "id": "body", "required": true, "accepts": ["ordered-section-instance"] },
        { "id": "footer", "required": false, "accepts": ["action-set"] }
      ],
      "stateModel": ["closed", "open", "dismissing", "committing"],
      "behaviorTargets": ["shell.dismiss", "shell.commit"],
      "scrollOwner": "shell-body",
      "allowedActionSets": ["action-set.cancel-save", "action-set.cancel-confirm", "action-set.save-only", "action-set.close-only"],
      "useWhen": ["전체 컨셉과 적용 가능한 MES 계약 또는 사용자 지정이 우측 작업 형식"],
      "doNotUseWhen": ["중앙 조회 팝업", "전체 페이지"],
      "constraints": ["우측 배치와 전체 높이를 유지한다.", "본문 섹션 순서를 ScreenSpec과 동일하게 렌더링한다."],
      "evidence": ["receiving", "production-result", "operation-log"],
      "goldenScreenIds": ["receiving"],
      "implementationMarkers": ["SideSlidePanel"]
    },
    {
      "patternId": "frame.standard-section",
      "slots": [
        { "id": "title", "required": false, "accepts": ["section-title"] },
        { "id": "action", "required": false, "accepts": ["section-local-action"] },
        { "id": "content", "required": true, "accepts": ["section-pattern"] }
      ],
      "stateModel": ["surface", "subtle", "divided"],
      "behaviorTargets": [],
      "scrollOwner": "none",
      "allowedActionSets": [],
      "useWhen": ["팝업 본문을 의미 있는 복수 섹션으로 나눔"],
      "doNotUseWhen": ["화면 셸", "표 안의 임의 장식 박스"],
      "constraints": ["padding·divider·background만 소유한다.", "고정 높이와 shell scroll을 소유하지 않는다."],
      "evidence": ["receiving", "production-result", "custom-information"],
      "goldenScreenIds": ["receiving"],
      "implementationMarkers": ["SectionFrame"]
    },
    {
      "patternId": "section.form-grid",
      "slots": [
        { "id": "fields", "required": true, "accepts": ["form-field-row"] }
      ],
      "stateModel": ["editable", "readonly", "disabled", "invalid"],
      "behaviorTargets": ["field.change", "field.validation"],
      "scrollOwner": "none",
      "allowedActionSets": [],
      "useWhen": ["label과 control의 반복 정렬이 필요한 입력 섹션"],
      "doNotUseWhen": ["열 비교·정렬이 핵심인 데이터 목록", "반복 행 추가·삭제"],
      "constraints": ["FormGrid가 열과 gap을 소유한다.", "FormFieldRow가 label·required marker·control 정렬을 소유한다."],
      "evidence": ["receiving", "custom-information", "cavity-layout-settings"],
      "goldenScreenIds": ["receiving"],
      "implementationMarkers": ["FormGrid", "FormFieldRow"]
    },
    {
      "patternId": "section.query-toolbar",
      "slots": [
        { "id": "start", "required": false, "accepts": ["filter", "group-query", "quick-query", "query-control"] },
        { "id": "end", "required": false, "accepts": ["search", "query-action"] }
      ],
      "stateModel": ["idle", "querying", "filtered", "empty-result"],
      "behaviorTargets": ["query.change", "query.submit", "query.reset"],
      "scrollOwner": "none",
      "allowedActionSets": [],
      "useWhen": ["둘 이상의 조회 도구가 같은 결과 집합을 갱신하며 한 줄의 작업 영역으로 읽혀야 할 때"],
      "doNotUseWhen": ["검색 또는 필터 하나만 독립적으로 배치해도 되는 경우", "서로 다른 결과 집합을 갱신하는 도구"],
      "constraints": ["start와 end를 수직 중앙 정렬한다.", "page·modal·compact variant는 부모 화면의 조회 문법에 따라 선택한다.", "균형을 맞추기 위해 존재하지 않는 검색·필터를 추가하지 않는다."],
      "evidence": ["material-input-settings", "inventory-add", "equipment-inspection-records"],
      "goldenScreenIds": ["material-input-settings"],
      "implementationMarkers": ["QueryToolbar"]
    },
    {
      "patternId": "section.bulk-edit-bar",
      "slots": [
        { "id": "title", "required": true, "accepts": ["section-local-title", "semantic-icon"] },
        { "id": "controls", "required": true, "accepts": ["labeled-input", "labeled-select", "date-picker", "form-control"] },
        { "id": "apply-action", "required": true, "accepts": ["button"] }
      ],
      "stateModel": ["idle", "dirty", "apply-enabled", "apply-disabled", "applied"],
      "behaviorTargets": ["bulk-value.change", "bulk-value.apply"],
      "scrollOwner": "none",
      "allowedActionSets": [],
      "useWhen": ["복수 행에 같은 값을 입력하고 명시적인 적용 동작으로 반영할 때"],
      "doNotUseWhen": ["단일 레코드만 편집할 때", "공통값이 즉시 모든 행에 반영되어 별도 적용 동작이 없는 경우", "단순 조회 도구"],
      "constraints": ["targetScope는 all-visible·selected·explicit-set 중 하나로 선언한다.", "행별 값과 충돌할 때의 우선순위를 화면 계약에서 명시한다.", "제목·입력·적용 버튼은 하나의 수평 영역으로 유지하되 컨트롤 수 때문에 table 밖 전체 화면을 넘치게 하지 않는다."],
      "evidence": ["inventory-add", "equipment-discharge-settings", "standard-price-settings", "team-settings"],
      "goldenScreenIds": ["inventory-add", "team-settings"],
      "implementationMarkers": ["BulkEditBar"]
    },
    {
      "patternId": "section.master-detail-composition",
      "slots": [
        { "id": "master", "required": true, "accepts": ["table", "list", "tree", "selection-control"] },
        { "id": "detail-title", "required": false, "accepts": ["content-region-heading"] },
        { "id": "detail", "required": true, "accepts": ["form-grid", "table", "analysis", "read-only-detail"] }
      ],
      "stateModel": ["unselected", "selected", "detail-loading", "detail-ready", "detail-empty"],
      "behaviorTargets": ["master.select", "detail.update", "detail.action"],
      "scrollOwner": "section",
      "allowedActionSets": [],
      "useWhen": ["한 영역에서 선택한 대상이 다른 영역의 정보·입력 가능 상태·행동을 결정할 때"],
      "doNotUseWhen": ["두 영역이 서로 독립적일 때", "단순한 원본·대상 비교처럼 선택에 따른 갱신이 없을 때"],
      "constraints": ["master와 detail은 같은 선택 ID 계약을 공유한다.", "가로·세로 방향과 비율은 종속 관계만이 아니라 비교 필요·정보량·가용 공간을 함께 보고 정한다.", "각 영역의 스크롤 주체를 중복 지정하지 않는다."],
      "evidence": ["equipment-discharge-settings", "standard-price-settings", "team-settings", "process-inspection-trend"],
      "goldenScreenIds": ["equipment-discharge-settings", "team-settings"],
      "implementationMarkers": ["MasterDetailSection", "useMasterDetailSelection"]
    },
    {
      "patternId": "section.search-table-composition",
      "slots": [
        { "id": "title-query", "required": false, "accepts": ["section-title", "query-control"] },
        { "id": "toolbar", "required": true, "accepts": ["section.query-toolbar", "filter", "search", "quick-query", "group-query"] },
        { "id": "bulk-action", "required": false, "accepts": ["section.bulk-edit-bar"] },
        { "id": "table", "required": true, "accepts": ["table-model"] },
        { "id": "selection-action", "required": false, "accepts": ["selection-action-bar"] },
        { "id": "footer-action", "required": false, "accepts": ["pagination", "local-action"] }
      ],
      "stateModel": ["idle", "querying", "empty", "selected", "editing"],
      "behaviorTargets": ["query.change", "table.selection", "table.active-row", "table.inline-edit"],
      "scrollOwner": "table",
      "allowedActionSets": [],
      "useWhen": ["검색·필터와 정렬된 데이터 표가 하나의 조회 영역을 이룸"],
      "doNotUseWhen": ["반복 입력 행을 정렬만 하기 위한 경우", "검색이나 표가 없는 폼"],
      "constraints": ["toolbar는 items-center를 소유한다.", "table만 가변 영역과 스크롤을 소유한다.", "존재하지 않는 slot을 장식 목적으로 만들지 않는다."],
      "evidence": ["batch-work-order", "material-input-settings", "grouped-production-list"],
      "goldenScreenIds": ["batch-work-order", "grouped-production-list"],
      "implementationMarkers": ["SearchTableSection", "SearchInput", "Table"]
    },
    {
      "patternId": "section.page-query-table",
      "slots": [
        { "id": "period-query", "required": true, "accepts": ["date-range-picker", "query-action"] },
        { "id": "query-toolbar", "required": true, "accepts": ["group-query", "filter", "quick-query", "search"] },
        { "id": "table", "required": true, "accepts": ["table-model"] }
      ],
      "stateModel": ["idle", "querying", "empty", "selected", "editing"],
      "behaviorTargets": ["query.change", "table.selection", "table.active-row", "table.row-open", "table.inline-edit"],
      "scrollOwner": "table",
      "allowedActionSets": [],
      "useWhen": ["MES 전체 페이지에서 업무 엔티티를 조건 조회하고 표에서 후속 작업으로 진입"],
      "doNotUseWhen": ["중앙 모달·슬라이드 팝업 내부의 검색 목록", "페이지네이션 기반 목록"],
      "constraints": ["페이지 조회 도구는 회색 section toolbar 안에 넣지 않는다.", "table이 세로 무한 스크롤을 소유한다.", "상세·슬라이드 팝업 진입은 행 더블클릭과 키보드 Enter를 사용한다."],
      "evidence": ["grouped-production-list", "production-result-responsive"],
      "goldenScreenIds": ["grouped-production-list", "production-result-responsive"],
      "implementationMarkers": ["EntityListPattern", "QueryDateRange", "GroupQuery", "Filter", "QuickQuery", "SearchInput", "Table", "IconCopy", "IconDownload"],
      "requiredComponentProps": ["EntityListPattern.footerStart"],
      "forbiddenImplementationMarkers": ["SearchTableSection", "Pagination"],
      "entryBehaviorContracts": {
        "row-double-click": {
          "requiredComponentProps": ["Table.onRowDoubleClick"]
        },
        "explicit-action": {
          "requiredComponentProps": []
        }
      }
    },
    {
      "patternId": "section.editable-row-list",
      "slots": [
        { "id": "entry-editor", "required": false, "accepts": ["form-grid"] },
        { "id": "header", "required": false, "accepts": ["column-header"] },
        { "id": "rows", "required": true, "accepts": ["editable-row"] },
        { "id": "add-action", "required": false, "accepts": ["button"] },
        { "id": "empty", "required": false, "accepts": ["empty-state"] }
      ],
      "stateModel": ["empty", "editing", "add-blocked", "add-enabled", "delete-blocked", "delete-enabled"],
      "behaviorTargets": ["row.add", "row.update", "row.delete"],
      "scrollOwner": "section",
      "allowedActionSets": [],
      "useWhen": ["사용자가 행을 직접 추가·수정·삭제하지만 표 탐색 기능은 필요 없음"],
      "doNotUseWhen": ["정렬·그룹·전체 선택이 필요한 데이터 표"],
      "constraints": ["헤더와 모든 행은 동일 columns 계약을 공유한다.", "stable ID와 추가 조건은 row.mutation-policy에 위임한다."],
      "evidence": ["receiving", "production-result", "operation-log"],
