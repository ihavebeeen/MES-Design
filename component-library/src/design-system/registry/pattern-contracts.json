        { "id": "rows", "required": true, "accepts": ["editable-row", "table-row"] },
        { "id": "row-action", "required": false, "accepts": ["button", "icon-button"] },
        { "id": "empty", "required": false, "accepts": ["empty-state"] }
      ],
      "stateModel": ["empty", "populated", "row-editing", "row-invalid"],
      "behaviorTargets": ["row.update", "row.delete", "row.validate"],
