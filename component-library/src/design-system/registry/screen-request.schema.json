{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mes-design.local/schemas/screen-request.schema.json",
  "title": "MES ScreenRequest",
  "description": "AI가 JSX를 작성하기 전에 확정해야 하는 MES 화면 생성 요청 계약",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "name", "intent", "lifecycle", "target", "composition", "requirements", "output"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "intent": { "enum": ["reproduce", "new", "normalize", "audit"] },
    "lifecycle": { "enum": ["draft", "release"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title"],
      "properties": {
        "kind": { "enum": ["page", "center-modal", "side-slide-panel", "confirm-dialog"] },
        "title": { "type": "string", "minLength": 1 },
        "nearestScreenId": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 320 },
            "height": { "type": "integer", "minimum": 320 }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "figmaNode": { "type": "string", "pattern": "^\\d+:\\d+$" },
        "sourceRoute": { "type": "string", "minLength": 1 },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/decisionEvidence" }
        }
      }
    },
    "webContext": {
      "type": "object",
      "description": "선택적으로 기록하는 관찰 사례 참조. 사례의 부재·미등록·다른 배치는 생성 차단 조건이 아니며 실제 구성은 composition/generation에서 정한다.",
      "additionalProperties": false,
      "properties": {
        "pageArchetypeRef": { "type": "string", "pattern": "^generation\\.page\\.[a-z0-9-]+$" },
        "overlayGrammarRef": { "type": "string", "pattern": "^generation\\.overlay\\.[a-z0-9-]+$" },
        "sectionRecipeRefs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^generation\\.section\\.[a-z0-9-]+$" },
          "uniqueItems": true
        }
      }
    },
    "assetDecisions": { "$ref": "#/$defs/assetDecisions" },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipeRefs": { "$ref": "#/$defs/refList" },
        "shellRef": { "type": "string", "minLength": 1 },
        "sectionRefs": { "$ref": "#/$defs/refList" },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sectionInstance" } },
        "behaviorRefs": { "$ref": "#/$defs/refList" },
        "actionSetRef": { "type": "string", "minLength": 1 }
      }
    },
    "requirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "normalizationDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "classification", "reason"],
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["source-error", "implementation-error", "intentional-exception", "normalization-candidate"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "generation": { "$ref": "#/$defs/generation" },
    "verificationScope": {
      "enum": ["surface", "connected-flow"],
      "description": "Requested verification scope, not a DS bypass. surface checks the page/popup itself; connected-flow additionally checks the business parent interaction and requires hostPage. Defaults to connected-flow when hostPage exists, otherwise surface. Never narrow a requested integration task to avoid a failure."
    },
    "hostPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "componentName", "triggerLabel", "saveBehavior"],
      "description": "Optional for popup-only work; required for connected-flow. Parent stays mounted and receives overlayActions, saveVersion, savedData props. Without it use the labeled MES preview frame, never invent a business list.",
      "properties": {
        "sourcePath": { "type": "string", "pattern": "^src/(?:[\\w-]+/)*[\\w-]+\\.(?:tsx|jsx)$" },
        "componentName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "triggerLabel": { "type": "string", "minLength": 1 },
        "saveBehavior": { "enum": ["notify-parent", "none"] },
        "pagePatternRef": {
          "type": "string",
          "minLength": 1,
          "description": "Executable host-page grammar. Unlike webContext references, this participates in validation."
        },
        "entryBehavior": {
          "enum": ["row-double-click", "explicit-action"],
          "description": "How an existing list record opens this popup. Required for connected-flow when the selected page pattern declares entry behavior contracts."
        },
        "entryReason": {
          "type": "string",
          "minLength": 1,
          "description": "Registered-screen or explicit user-approval evidence required when entryBehavior is explicit-action."
        },
        "entryEvidenceRef": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9.-]*$",
          "description": "evidence.decisions에서 실제 진입 동작 근거를 가리킨다."
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "componentName"],
      "properties": {
        "route": { "type": "string", "pattern": "^/preview/[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "componentName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
      }
    }
  },
  "$defs": {
    "decisionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "questionId", "state", "sourceType", "sourceRef", "statement"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9.-]*$" },
        "questionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$" },
        "state": { "enum": ["confirmed", "supported", "assumed", "unresolved"] },
        "sourceType": { "enum": ["user-request", "functional-spec", "registered-contract", "figma-source", "mes-reference", "agent-proposal"] },
        "sourceRef": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "decisionSubject": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$",
          "description": "여러 독립 근거가 함께 설명하는 실제 선택 대상"
        },
        "factor": {
          "enum": ["explicit-direction", "task-purpose", "information-role", "workflow", "information-relationship", "interaction-continuity", "space-density", "pattern-context", "selection-cardinality", "selection-result", "batch-action", "safety-reversibility"],
          "description": "selection-context-framework.json의 공통 맥락 축에 연결되는 판단 factor"
        },
        "selectedOption": {
          "type": "string",
          "minLength": 1,
          "description": "이 근거가 지지하는 실제 선택값"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option", "reason"],
            "properties": {
              "option": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "assetDecisions": {
      "type": "object",
      "description": "ScreenRequest 확정 전에 검토한 의미 요소와 채택 결정을 보존한다. 후보 추천은 자동 선택이나 생성 차단이 아니다.",
      "additionalProperties": false,
      "required": ["schemaVersion", "elements"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "notApplicableCategories": {
          "type": "array",
          "items": { "$ref": "#/$defs/semanticAssetCategory" },
          "uniqueItems": true
        },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/semanticAssetElement" }
        }
      }
    },
    "semanticAssetCategory": {
      "enum": ["application-frame", "navigation-query", "content-structure", "data-display", "status-feedback", "input-selection", "actions", "overlay-behavior"]
    },
    "semanticAssetElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "category", "capability", "parentRefs", "basis", "impact", "decision"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9.-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/semanticAssetCategory" },
        "capability": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "parentRefs": { "$ref": "#/$defs/refList" },
        "basis": { "enum": ["confirmed", "supported", "assumed", "unresolved"] },
        "impact": { "enum": ["presentation", "business-behavior"] },
        "decision": { "enum": ["selected", "deferred", "not-applicable", "propose-new"] },
        "selectedComponentRef": { "type": "string", "minLength": 1 },
        "candidateComponentRefs": { "$ref": "#/$defs/refList" },
        "evidenceRef": { "type": "string", "pattern": "^[a-z][A-Za-z0-9.-]*$" },
        "decisionSubject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "selected" } }, "required": ["decision"] },
          "then": { "required": ["selectedComponentRef"] },
          "else": { "not": { "required": ["selectedComponentRef"] } }
        },
        {
          "if": { "properties": { "decision": { "const": "selected" }, "impact": { "const": "business-behavior" } }, "required": ["decision", "impact"] },
          "then": { "required": ["evidenceRef", "decisionSubject"] }
        }
      ]
    },
    "slideCompositionGeneration": {"type":"object","properties":{"templateId":{"type":"string","enum":["side-slide-custom-fields.v1","side-slide-inspection.v1","side-slide-entry-list.v1","side-slide-group-settings.v1"]},"panelSize":{"type":"string","enum":["narrow-760","medium-849","standard-900","wide-960"]},"sections":{"minItems":2,"type":"array","items":{"oneOf":[{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"title":{"type":"string","minLength":1},"kind":{"type":"string","const":"form-grid"},"fields":{"minItems":1,"type":"array","items":{"type":"object","properties":{"key":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"label":{"type":"string","minLength":1},"control":{"type":"string","enum":["input","select"]},"defaultValue":{"type":"string"},"required":{"type":"boolean"},"readOnly":{"type":"boolean"},"placeholder":{"type":"string"},"inputMode":{"type":"string","enum":["text","numeric","decimal"]},"validation":{"type":"string","enum":["non-empty","positive-number"]},"options":{"minItems":1,"type":"array","items":{"type":"string","minLength":1}}},"required":["key","label","control","defaultValue"],"additionalProperties":false}},"columns":{"anyOf":[{"type":"number","const":1},{"type":"number","const":2}]},"density":{"type":"string","enum":["compact","comfortable"]},"divider":{"type":"string","enum":["none","bottom"]}},"required":["id","title","kind","fields"],"additionalProperties":false},{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"title":{"type":"string","minLength":1},"kind":{"type":"string","const":"custom-fields"},"fields":{"type":"array","items":{"type":"object","properties":{"key":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"label":{"type":"string","minLength":1},"control":{"type":"string","enum":["input","select"]},"defaultValue":{"type":"string"},"required":{"type":"boolean"},"readOnly":{"type":"boolean"},"placeholder":{"type":"string"},"inputMode":{"type":"string","enum":["text","numeric","decimal"]},"validation":{"type":"string","enum":["non-empty","positive-number"]},"options":{"minItems":1,"type":"array","items":{"type":"string","minLength":1}}},"required":["key","label","control","defaultValue"],"additionalProperties":false}},"availableFields":{"type":"array","items":{"type":"object","properties":{"key":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"label":{"type":"string","minLength":1},"control":{"type":"string","enum":["input","select"]},"defaultValue":{"type":"string"},"required":{"type":"boolean"},"readOnly":{"type":"boolean"},"placeholder":{"type":"string"},"inputMode":{"type":"string","enum":["text","numeric","decimal"]},"validation":{"type":"string","enum":["non-empty","positive-number"]},"options":{"minItems":1,"type":"array","items":{"type":"string","minLength":1}}},"required":["key","label","control","defaultValue"],"additionalProperties":false}}},"required":["id","title","kind","fields","availableFields"],"additionalProperties":false},{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"title":{"type":"string","minLength":1},"kind":{"type":"string","const":"inspection-items"},"items":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"label":{"type":"string","minLength":1},"value":{"type":"string","enum":["pass","hold","fail","none"]}},"required":["id","label","value"],"additionalProperties":false}},"availableItems":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"label":{"type":"string","minLength":1},"value":{"type":"string","enum":["pass","hold","fail","none"]}},"required":["id","label","value"],"additionalProperties":false}}},"required":["id","title","kind","items","availableItems"],"additionalProperties":false},{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"title":{"type":"string","minLength":1},"kind":{"type":"string","const":"entry-form"},"fields":{"minItems":1,"type":"array","items":{"type":"object","properties":{"key":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"label":{"type":"string","minLength":1},"control":{"type":"string","enum":["input","select"]},"defaultValue":{"type":"string"},"required":{"type":"boolean"},"readOnly":{"type":"boolean"},"placeholder":{"type":"string"},"inputMode":{"type":"string","enum":["text","numeric","decimal"]},"validation":{"type":"string","enum":["non-empty","positive-number"]},"options":{"minItems":1,"type":"array","items":{"type":"string","minLength":1}}},"required":["key","label","control","defaultValue"],"additionalProperties":false}},"inheritOnAdd":{"type":"array","items":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"}}},"required":["id","title","kind","fields","inheritOnAdd"],"additionalProperties":false},{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"title":{"type":"string","minLength":1},"kind":{"type":"string","const":"record-list"},"columns":{"minItems":1,"type":"array","items":{"type":"object","properties":{"key":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"label":{"type":"string","minLength":1},"control":{"type":"string","enum":["input","select"]},"defaultValue":{"type":"string"},"required":{"type":"boolean"},"readOnly":{"type":"boolean"},"placeholder":{"type":"string"},"inputMode":{"type":"string","enum":["text","numeric","decimal"]},"validation":{"type":"string","enum":["non-empty","positive-number"]},"options":{"minItems":1,"type":"array","items":{"type":"string","minLength":1}},"align":{"type":"string","enum":["left","center","right"]}},"required":["key","label","control","defaultValue"],"additionalProperties":false}},"addMethods":{"minItems":1,"type":"array","items":{"type":"string","enum":["blank-row","entry-form"]}},"editableFields":{"type":"array","items":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"}},"rows":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"values":{"type":"object","propertyNames":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"additionalProperties":{"type":"string"}}},"required":["id","values"],"additionalProperties":false}},"minRecords":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["id","title","kind","columns","addMethods","editableFields","rows","minRecords"],"additionalProperties":false},{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"title":{"type":"string","minLength":1},"kind":{"type":"string","const":"member-selection"},"members":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"name":{"type":"string","minLength":1},"email":{"type":"string"},"department":{"type":"string"},"group":{"type":"string"},"disabled":{"type":"boolean"}},"required":["id","name","email","department","group"],"additionalProperties":false}},"selectedIds":{"type":"array","items":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"}}},"required":["id","title","kind","members","selectedIds"],"additionalProperties":false},{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"title":{"type":"string","minLength":1},"kind":{"type":"string","const":"permission-matrix"},"columns":{"minItems":1,"type":"array","items":{"type":"object","properties":{"key":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"label":{"type":"string","minLength":1}},"required":["key","label"],"additionalProperties":false}},"rows":{"minItems":1,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"label":{"type":"string","minLength":1},"parentId":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"values":{"type":"object","propertyNames":{"type":"string","pattern":"^[a-z][A-Za-z0-9]*$"},"additionalProperties":{"type":"boolean"}}},"required":["id","label"],"additionalProperties":false}}},"required":["id","title","kind","columns","rows"],"additionalProperties":false}]}}},"required":["templateId","panelSize","sections"],"additionalProperties":false},
    "refList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "generation": {
      "oneOf": [
        { "$ref": "#/$defs/slideCompositionGeneration" },
        { "$ref": "#/$defs/sideSlideGeneration" },
        { "$ref": "#/$defs/centerModalGeneration" },
        { "$ref": "#/$defs/pageEntityListGeneration" }
      ]
    },
    "sectionInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slot", "patternRef", "componentRefs", "behaviorRefs", "scrollOwner"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "title": { "type": "string", "minLength": 1 },
        "slot": { "const": "body" },
        "frameRef": { "type": "string", "minLength": 1 },
        "patternRef": { "type": "string", "minLength": 1 },
        "supportingPatternRefs": { "$ref": "#/$defs/refList" },
        "componentRefs": { "$ref": "#/$defs/refList" },
        "behaviorRefs": { "$ref": "#/$defs/refList" },
        "scrollOwner": { "enum": ["shell-body", "section", "table", "none"] }
      }
    },
    "sideSlideGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "panelSize", "sections"],
      "properties": {
        "templateId": { "const": "side-slide-form-editable-list.v1" },
        "panelSize": { "enum": ["narrow-760", "medium-849", "standard-900", "wide-960"] },
        "sections": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/$defs/formSection" }, { "$ref": "#/$defs/editableRowSection" }] } }
      }
    },
    "centerModalGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "modalSize", "sections"],
      "properties": {
        "templateId": { "const": "center-modal-search-table.v1" },
        "modalSize": { "enum": ["medium-600", "standard-960", "wide-1024", "large-1100", "wide-1142", "wide-1400"] },
        "sections": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/searchTableSection" } }
      }
    },
    "pageEntityListGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "pageTitle", "navigationLabel", "navigationItemLabel", "tabLabel", "sections"],
      "properties": {
        "templateId": { "const": "page-entity-list.v1" },
        "pageTitle": { "type": "string", "minLength": 1 },
        "navigationLabel": { "type": "string", "minLength": 1 },
        "navigationItemLabel": { "type": "string", "minLength": 1 },
        "tabLabel": { "type": "string", "minLength": 1 },
        "sections": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/searchTableSection" } }
      }
    },
    "formSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "const": "form-grid" },
        "divider": { "enum": ["none", "bottom"] },
        "columns": { "enum": [1, 2] },
        "density": { "enum": ["compact", "comfortable"] },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } }
      }
    },
    "editableRowSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "columns"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "const": "editable-row-list" },
        "divider": { "enum": ["none", "bottom"] },
        "addLabel": { "type": "string", "minLength": 1 },
        "minRows": { "type": "integer", "minimum": 1, "maximum": 20 },
        "insertPosition": { "enum": ["start", "end"] },
        "inheritOnAdd": { "type": "array", "items": { "$ref": "#/$defs/key" }, "uniqueItems": true },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rowColumn" } }
      }
    },
    "searchTableSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "filters", "columns", "rows"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "const": "search-table" },
        "searchPlaceholder": { "type": "string" },
        "selectable": { "type": "boolean" },
        "filters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tableFilter" } },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tableColumn" } },
        "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tableRow" } }
      }
    },
    "tableFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "options"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tableFilterOption" } }
      }
    },
    "tableFilterOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "tableColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "width"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 40, "maximum": 800 },
        "align": { "enum": ["left", "center", "right"] }
      }
    },
    "tableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "values"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
