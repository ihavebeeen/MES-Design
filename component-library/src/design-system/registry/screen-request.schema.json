{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mes-design.local/schemas/screen-request.schema.json",
  "title": "MES ScreenRequest",
  "description": "AI가 JSX를 작성하기 전에 확정해야 하는 MES 화면 생성 요청 계약",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "name", "intent", "lifecycle", "target", "composition", "requirements", "output"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "intent": { "enum": ["reproduce", "new", "normalize", "audit"] },
    "lifecycle": { "enum": ["draft", "release"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title"],
      "properties": {
        "kind": { "enum": ["page", "center-modal", "side-slide-panel", "confirm-dialog"] },
        "title": { "type": "string", "minLength": 1 },
        "nearestScreenId": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 320 },
            "height": { "type": "integer", "minimum": 320 }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "figmaNode": { "type": "string", "pattern": "^\\d+:\\d+$" },
        "sourceRoute": { "type": "string", "minLength": 1 },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipeRefs": { "$ref": "#/$defs/refList" },
        "shellRef": { "type": "string", "minLength": 1 },
        "sectionRefs": { "$ref": "#/$defs/refList" },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sectionInstance" } },
        "behaviorRefs": { "$ref": "#/$defs/refList" },
        "actionSetRef": { "type": "string", "minLength": 1 }
      }
    },
    "requirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "normalizationDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "classification", "reason"],
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["source-error", "implementation-error", "intentional-exception", "normalization-candidate"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "generation": { "$ref": "#/$defs/generation" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "componentName"],
      "properties": {
        "route": { "type": "string", "pattern": "^/preview/[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "componentName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
      }
    }
  },
  "$defs": {
    "refList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "generation": {
      "oneOf": [
        { "$ref": "#/$defs/sideSlideGeneration" },
        { "$ref": "#/$defs/centerModalGeneration" },
        { "$ref": "#/$defs/pageEntityListGeneration" }
      ]
    },
    "sectionInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slot", "patternRef", "componentRefs", "behaviorRefs", "scrollOwner"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "title": { "type": "string", "minLength": 1 },
        "slot": { "const": "body" },
        "frameRef": { "type": "string", "minLength": 1 },
        "patternRef": { "type": "string", "minLength": 1 },
        "supportingPatternRefs": { "$ref": "#/$defs/refList" },
        "componentRefs": { "$ref": "#/$defs/refList" },
        "behaviorRefs": { "$ref": "#/$defs/refList" },
        "scrollOwner": { "enum": ["shell-body", "section", "table", "none"] }
      }
    },
    "sideSlideGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "panelSize", "sections"],
      "properties": {
        "templateId": { "const": "side-slide-form-editable-list.v1" },
        "panelSize": { "enum": ["narrow-760", "medium-849", "standard-900", "wide-960"] },
        "sections": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/$defs/formSection" }, { "$ref": "#/$defs/editableRowSection" }] } }
      }
    },
    "centerModalGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "modalSize", "sections"],
      "properties": {
        "templateId": { "const": "center-modal-search-table.v1" },
        "modalSize": { "enum": ["medium-600", "standard-960", "wide-1024", "large-1100", "wide-1142", "wide-1400"] },
        "sections": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/searchTableSection" } }
      }
    },
    "pageEntityListGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "pageTitle", "navigationLabel", "navigationItemLabel", "tabLabel", "pageSize", "sections"],
      "properties": {
        "templateId": { "const": "page-entity-list.v1" },
        "pageTitle": { "type": "string", "minLength": 1 },
        "navigationLabel": { "type": "string", "minLength": 1 },
        "navigationItemLabel": { "type": "string", "minLength": 1 },
        "tabLabel": { "type": "string", "minLength": 1 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 },
        "sections": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/searchTableSection" } }
      }
    },
    "formSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "const": "form-grid" },
        "divider": { "enum": ["none", "bottom"] },
        "columns": { "enum": [1, 2] },
        "density": { "enum": ["compact", "comfortable"] },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } }
      }
    },
    "editableRowSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "columns"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "const": "editable-row-list" },
        "divider": { "enum": ["none", "bottom"] },
        "addLabel": { "type": "string", "minLength": 1 },
        "minRows": { "type": "integer", "minimum": 1, "maximum": 20 },
        "insertPosition": { "enum": ["start", "end"] },
        "inheritOnAdd": { "type": "array", "items": { "$ref": "#/$defs/key" }, "uniqueItems": true },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rowColumn" } }
      }
    },
    "searchTableSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "filters", "columns", "rows"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "const": "search-table" },
        "searchPlaceholder": { "type": "string" },
        "selectable": { "type": "boolean" },
        "filters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tableFilter" } },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tableColumn" } },
        "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tableRow" } }
      }
    },
    "tableFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "options"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tableFilterOption" } }
      }
    },
    "tableFilterOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "tableColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "width"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 40, "maximum": 800 },
        "align": { "enum": ["left", "center", "right"] }
      }
    },
    "tableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "values"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "values": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "control", "defaultValue"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1 },
        "control": { "enum": ["input", "select"] },
        "defaultValue": { "type": "string" },
        "required": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "inputMode": { "enum": ["text", "numeric", "decimal"] },
        "validation": { "enum": ["non-empty", "positive-number"] },
        "options": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "rowColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "control", "defaultValue"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1 },
        "control": { "enum": ["input", "select"] },
        "defaultValue": { "type": "string" },
        "required": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "inputMode": { "enum": ["text", "numeric", "decimal"] },
        "validation": { "enum": ["non-empty", "positive-number"] },
        "options": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "width": { "enum": ["unit", "compact", "standard", "wide", "flex"] },
        "align": { "enum": ["left", "center", "right"] }
      }
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    }
  }
}
