{
  "schemaVersion": 1,
  "frameworkId": "mes.component-state-framework",
  "frameworkVersion": "1.0.0",
  "authority": "component-state-framework",
  "purpose": "컴포넌트의 의미 상태, 값, 비활성화, 크기, 상호작용을 서로 덮어쓰지 않는 독립 축으로 기록한다.",
  "dimensionOrder": [
    "state",
    "value",
    "disabled",
    "size",
    "interaction"
  ],
  "compositionMode": "orthogonal-axes",
  "cartesianExpansion": "valid-combinations-only",
  "notApplicableValue": "not-applicable",
  "dimensions": [
    {
      "id": "state",
      "name": "State",
      "meaning": "컴포넌트의 의미 또는 표시 상태. 값 보유 여부, disabled, 크기, 순간 상호작용은 포함하지 않는다."
    },
    {
      "id": "value",
      "name": "Value",
      "meaning": "비어 있음·입력됨·선택됨·체크됨처럼 사용자가 보거나 변경하는 값 상태를 기록한다."
    },
    {
      "id": "disabled",
      "name": "Disabled",
      "meaning": "조작 가능 여부를 boolean 축으로 기록하며 State나 Interaction 값으로 합치지 않는다."
    },
    {
      "id": "size",
      "name": "Size",
      "meaning": "컴포넌트가 실제 구현에서 지원하는 크기 이름만 기록한다."
    },
    {
      "id": "interaction",
      "name": "Interaction",
      "meaning": "rest·hover·focus처럼 포인터나 키보드 조작 중 나타나는 일시적 시각 상태를 기록한다."
    }
  ],
  "rules": [
    "다섯 축은 항상 같은 순서로 노출하고 지원하지 않는 축은 not-applicable로 명시한다.",
    "Disabled=true에서는 hover·focus 같은 조작 상태를 요구하지 않는다.",
    "Value를 State 이름으로, Disabled를 Interaction 이름으로 중복 표현하지 않는다.",
    "모든 축의 곱을 Figma variant 수로 강제하지 않고 실제로 유효한 조합만 문서화·검증한다.",
    "Size와 장식용 variant 또는 아이콘 배치는 상태 축과 독립적으로 유지한다."
  ],
  "componentOverrides": {
    "button": {
      "state": ["default"],
      "value": ["not-applicable"],
      "disabled": ["false", "true"],
      "size": ["basic", "small", "xsmall"],
      "interaction": ["rest", "hover"]
    },
    "input": {
      "state": ["default", "readOnly"],
      "value": ["empty", "filled"],
      "disabled": ["false", "true"],
      "size": ["default", "small"],
      "interaction": ["rest", "focus"]
    },
    "select": {
      "state": ["closed", "open"],
      "value": ["empty", "selected"],
      "disabled": ["false", "true"],
      "size": ["default", "small"],
      "interaction": ["rest", "hover"]
    },
    "checkbox": {
      "state": ["default"],
      "value": ["unchecked", "checked", "indeterminate"],
      "disabled": ["false", "true"],
      "size": ["small", "default"],
      "interaction": ["rest"]
    },
    "radio": {
      "state": ["default"],
      "value": ["unchecked", "checked"],
      "disabled": ["false", "true"],
      "size": ["small", "default"],
      "interaction": ["rest"]
    },
    "switch": {
      "state": ["default"],
      "value": ["off", "on"],
      "disabled": ["false", "true"],
      "size": ["default", "compact"],
      "interaction": ["rest"]
    },
    "toggle-button": {
      "state": ["default"],
      "value": ["unpressed", "pressed"],
      "disabled": ["false", "true"],
      "size": ["basic", "small", "xsmall"],
      "interaction": ["rest", "hover"]
    },
    "textarea": {
      "state": ["default", "readOnly"],
      "value": ["empty", "filled"],
      "disabled": ["false", "true"],
      "size": ["not-applicable"],
      "interaction": ["rest", "focus"]
    },
    "password-input": {
      "state": ["default"],
      "value": ["empty", "filled"],
      "disabled": ["false", "true"],
      "size": ["default", "small"],
      "interaction": ["rest", "hover", "focus"]
    },
    "number-input": {
      "state": ["default"],
      "value": ["empty", "filled"],
      "disabled": ["false", "true"],
      "size": ["default", "small"],
      "interaction": ["rest", "hover", "focus"]
    },
    "search-input": {
      "state": ["default"],
      "value": ["empty", "filled"],
      "disabled": ["not-applicable"],
      "size": ["default", "compact"],
      "interaction": ["rest", "focus"]
    },
    "multi-select-input": {
      "state": ["default"],
      "value": ["empty", "multiple-selected"],
      "disabled": ["false", "true"],
      "size": ["not-applicable"],
      "interaction": ["rest", "focus"]
    },
    "date-picker": {
      "state": ["closed", "open"],
      "value": ["empty", "filled"],
      "disabled": ["false", "true"],
      "size": ["default", "small"],
      "interaction": ["rest", "hover", "focus"]
    },
    "date-range-picker": {
      "state": ["closed", "open"],
      "value": ["empty", "filled"],
      "disabled": ["false", "true"],
      "size": ["default"],
      "interaction": ["rest", "hover", "focus"]
    },
    "time-picker": {
      "state": ["closed", "open"],
      "value": ["empty", "filled"],
      "disabled": ["false", "true"],
      "size": ["default"],
      "interaction": ["rest", "hover", "focus"]
    },
    "file-upload": {
      "state": ["default"],
      "value": ["no-files", "files-selected"],
      "disabled": ["false", "true"],
      "size": ["not-applicable"],
      "interaction": ["rest", "hover", "focus"]
    },
    "slider": {
      "state": ["default"],
      "value": ["set"],
      "disabled": ["false", "true"],
      "size": ["not-applicable"],
      "interaction": ["rest", "focus", "drag"]
    },
    "tree-select": {
      "state": ["default", "expanded"],
      "value": ["empty", "multiple-selected"],
      "disabled": ["not-applicable"],
      "size": ["not-applicable"],
      "interaction": ["rest", "hover", "focus"]
    },
    "cascader": {
      "state": ["default"],
      "value": ["unselected", "selected"],
      "disabled": ["not-applicable"],
      "size": ["not-applicable"],
      "interaction": ["rest", "hover", "focus"]
    },
    "segmented-control": {
      "state": ["default"],
      "value": ["unselected", "selected"],
      "disabled": ["false", "true"],
      "size": ["not-applicable"],
      "interaction": ["rest", "hover", "focus"]
    }
  }
}
