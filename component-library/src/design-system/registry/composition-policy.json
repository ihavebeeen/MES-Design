{
  "schemaVersion": 1,
  "policyId": "mes.ai-composition-grammar",
  "policyVersion": "1.4.0",
  "status": "active",
  "authority": "common-policy",
  "layers": [
    { "id": "token-asset", "role": "visual-primitives" },
    { "id": "component", "role": "independent-ui-control" },
    { "id": "context-rule", "role": "semantic-selection-and-exclusion-contract" },
    { "id": "shell", "role": "screen-or-overlay-slots" },
    { "id": "section-frame", "role": "section-visual-contract" },
    { "id": "section-pattern", "role": "reusable-content-composition" },
    { "id": "behavior-pattern", "role": "state-and-interaction-contract" },
    { "id": "recipe-archetype", "role": "verified-pattern-composition" },
    { "id": "screen-spec", "role": "concrete-screen-definition" }
  ],
  "grammar": {
    "contextDecision": ["semanticRole:1", "parentContext:1", "taskShape:1", "informationStructure:1", "interactionEffect:1", "stateLifetime:1", "dataShape:1", "scrollOwner:1", "sourceEvidence:1"],
    "screenSpec": ["shell:1", "sections:1..n", "behaviors:0..n", "actionSet:1"],
    "sectionInstance": ["sectionFrame:1", "sectionPattern:1", "screenConfig:1"],
    "shellSlots": ["header", "body", "footer"],
    "sectionFrameVariants": ["standard", "collapsible", "none"]
  },
  "assetSelectionLadder": {
    "scope": ["component", "section-pattern", "behavior-pattern", "shell", "action-set"],
    "steps": [
      {
        "id": "exact-match",
        "question": "요구된 의미·동작·상태·부모 맥락에 정확히 맞는 승인 자산이 있는가?",
        "passOutcome": ["reuse"],
        "failAction": "compatible-existing 단계로 이동"
      },
      {
        "id": "compatible-existing",
        "question": "가장 가까운 기존 자산을 의미 변경 없이 재사용·조합·확장할 수 있는가?",
        "comparisonAxes": ["semantic-role", "interaction-effect", "selection-cardinality", "state-model", "accessibility-contract", "allowed-parent", "information-hierarchy"],
        "passOutcome": ["reuse", "compose", "extend"],
        "failAction": "유사 자산을 사용하지 않고 new-asset 단계로 이동"
      },
      {
        "id": "new-asset",
        "question": "정확한 자산도 없고 기존 자산의 의미를 보존한 표현도 불가능한가?",
        "passOutcome": ["propose-new"],
        "failAction": "요구사항 또는 후보 판정을 다시 확인",
        "approval": "required-and-quarantined-before-approval"
      }
    ],
    "similarityRule": "시각적 유사성은 2단계 후보를 찾는 단서일 뿐 사용 허가가 아니다.",
    "example": "단일 선택 Radio가 없을 때 복수·독립 선택 Checkbox는 selection-cardinality와 state-model이 달라 2단계에서 탈락하며 Radio를 신규 제안한다."
  },
  "decisionOutcomes": ["reuse", "compose", "extend", "propose-new", "normalize"],
  "approval": {
    "automatic": ["verified-reuse"],
    "requiresHuman": ["meaning-changing-extend", "propose-new"],
    "quarantineBeforeApproval": true
  },
  "registrationQuestions": [
    "screen-independent-role",
    "cross-screen-reuse",
    "own-layout-slot-or-state-contract",
    "independent-testability",
    "clearer-than-existing-configuration"
  ],
  "forbiddenWithoutDecision": [
    "unregistered-wrapper",
    "unregistered-information-hierarchy",
    "unregistered-background-radius-composition",
    "unsupported-helper-copy"
  ],
  "migrationHolds": [
    { "id": "screen-single-pattern-id", "target": "screens.json.patternRefs", "status": "resolved", "decision": "모든 ScreenSpec을 복수 patternRefs로 이관했다." },
    { "id": "mixed-pattern-granularity", "target": "patterns.json", "status": "resolved", "decision": "Shell·Section·Behavior·ActionSet을 명시적으로 등록하고 기존 화면 단위 항목은 Recipe 호환 계층으로 유지한다." },
    { "id": "source-asset-pattern-boundary", "target": "source-assets.json.patterns", "status": "resolved", "decision": "원본 자산은 별도 증거 파일에 두되 런타임 레지스트리에서는 표준 패턴과 합성한다." },
    { "id": "single-pattern-context-api", "target": "getImplementationContext", "status": "resolved", "decision": "복수 patterns, 중복 제거된 components, 관련 contextRules와 contextDecisions를 반환한다." },
    { "id": "single-pattern-validator", "target": "check-design-system-registry", "status": "resolved", "decision": "빈 배열·중복·미등록 patternRefs를 검증한다." },
    { "id": "archetype-recipe-boundary", "target": "MES Archetype documentation", "status": "resolved", "decision": "화면 단위 구현은 Recipe, 재사용 문법은 Shell·Section·Behavior·ActionSet으로 구분한다." },
    { "id": "mixed-pattern-source-directory", "target": "src/components/patterns", "status": "closed-no-action", "decision": "대규모 파일 이동은 import churn만 만들므로 논리 레지스트리 분류를 우선하고 실제 이동은 하지 않는다." }
  ]
}
