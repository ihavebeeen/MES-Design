{
  "name": "mes-component-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:design-system": "eslint src/design-system src/components/visual-tests src/app/visual-regression tests/visual playwright.config.ts scripts/check-design-system-registry.mjs scripts/audit-design-values.mjs scripts/audit-composition-inventory.mjs",
    "check:patterns": "node scripts/check-pattern-component-reuse.mjs",
    "check:registry": "node scripts/check-design-system-registry.mjs",
    "audit:design-values": "node scripts/audit-design-values.mjs --write",
    "check:design-values": "node scripts/audit-design-values.mjs --check",
    "audit:composition": "node scripts/audit-composition-inventory.mjs --write",
    "check:composition-inventory": "node scripts/audit-composition-inventory.mjs --check",
    "check:design-system": "npm run check:patterns && npm run check:registry && npm run check:design-values && npm run check:composition-inventory",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
