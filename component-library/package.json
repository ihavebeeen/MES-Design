{
  "name": "mes-component-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:design-system": "eslint src/design-system src/components/experimental src/components/visual-tests src/app/visual-regression tests/visual playwright.config.ts scripts/check-design-system-registry.mjs scripts/check-experimental-registry.mjs scripts/render-experimental-decisions.mjs scripts/generated-text.mjs scripts/audit-design-values.mjs scripts/audit-composition-inventory.mjs scripts/audit-tier-coverage.mjs scripts/audit-web-verification-coverage.mjs scripts/run-affected-visual-tests.mjs scripts/screen-generation-contract.mjs scripts/resolve-screen-request.mjs scripts/generate-screen-tsx.mjs scripts/generate-screen-preview.mjs scripts/check-screen-request-fixtures.mjs scripts/audit-screen-implementation.mjs scripts/mes-ui-mcp-server.mjs scripts/check-mes-ui-mcp.mjs scripts/check-doc-links.mjs scripts/screen-implementation-graph.mjs scripts/screen-handoff.mjs scripts/check-screen-delivery.mjs",
    "check:patterns": "node scripts/check-pattern-component-reuse.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "business:context": "node scripts/business-knowledge.mjs",
    "check:business-knowledge": "node scripts/business-knowledge.mjs --check && node --test scripts/business-knowledge.test.mjs",
    "check:registry": "node scripts/check-design-system-registry.mjs",
    "sync:assets": "node scripts/sync-design-system-assets.mjs --write",
    "check:assets": "node scripts/sync-design-system-assets.mjs --check",
    "audit:design-values": "node scripts/audit-design-values.mjs --write",
    "check:design-values": "node scripts/audit-design-values.mjs --check",
    "audit:composition": "node scripts/audit-composition-inventory.mjs --write",
    "check:composition-inventory": "node scripts/audit-composition-inventory.mjs --check",
    "audit:tier-coverage": "node scripts/audit-tier-coverage.mjs --write",
    "check:tier-coverage": "node scripts/audit-tier-coverage.mjs --check",
    "audit:web-coverage": "node scripts/audit-web-verification-coverage.mjs --write",
    "check:web-coverage": "node scripts/audit-web-verification-coverage.mjs --check",
    "check:experimental": "node scripts/check-experimental-registry.mjs",
    "audit:experimental-decisions": "node scripts/render-experimental-decisions.mjs --write",
    "check:experimental-decisions": "node scripts/render-experimental-decisions.mjs --check",
    "screen:resolve": "node scripts/resolve-screen-request.mjs",
    "screen:generate": "node scripts/generate-screen-tsx.mjs",
    "screen:preview": "node scripts/generate-screen-preview.mjs",
    "screen:audit": "node scripts/audit-screen-implementation.mjs",
    "screen:handoff": "node scripts/screen-handoff.mjs",
    "check:screen-delivery": "node scripts/check-screen-delivery.mjs",
    "mcp:start": "node scripts/mes-ui-mcp-server.mjs",
    "mcp:check": "node scripts/check-mes-ui-mcp.mjs",
    "check:screen-contracts": "node scripts/check-screen-request-fixtures.mjs && npm run check:screen-delivery",
    "check:design-system": "npm run check:docs && npm run check:business-knowledge && npm run check:patterns && npm run check:registry && npm run check:assets && npm run check:experimental && npm run check:experimental-decisions && npm run check:design-values && npm run check:composition-inventory && npm run check:tier-coverage && npm run check:web-coverage && npm run check:screen-contracts && npm run mcp:check",
    "test:visual": "playwright test",
    "test:visual:changed": "node scripts/run-affected-visual-tests.mjs",
    "verify:changed": "npm run check:registry && npm run test:visual:changed",
    "verify:full": "node scripts/run-full-verification.mjs",
    "test:mobile:verification": "playwright test tests/visual/mobile-design-system.spec.ts --grep \"모바일 검증\"",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
